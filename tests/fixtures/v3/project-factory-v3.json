  ],
  "report": {"changes": [{"metric": "uptime", "ruleId": "maintenance-signal", "evidenceIds": ["asset-data"]}]},
  "portfolioPolicy": {"lifecycleStates": ["deferred", "research", "pilot", "scale"], "budgetPosture": "constrained", "budget": {"currency": "INR", "capitalEnvelope": 5}},
  "eventCoverage": {"line-failure": "implemented"}
