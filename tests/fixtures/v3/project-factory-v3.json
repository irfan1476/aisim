  "initiatives": [
    {"id": "maintenance", "valueMetric": "uptime", "dependencies": [], "evidenceRequired": ["asset-data"], "ownerRole": "operations", "lifecycle": {"allowedTransitions": ["deferred to research", "research to pilot", "pilot to scale"]}, "capacityRequired": {"technicians": {"research": 2, "pilot": 4, "scale": 6}}, "effect": {"metric": "uptime", "delta": 5, "unit": "%", "sourceRuleId": "maintenance-signal", "sourceEvidenceIds": ["asset-data"]}}
  ],
  "gates": [
    {"id": "asset-evidence", "appliesTo": ["maintenance"], "ownerRole": "operations", "requiredEvidence": ["asset-data"], "conditions": ["metric.uptime >= 70"], "explanation": "Telemetry must be reviewed before pilot."}
